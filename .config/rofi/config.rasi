/*
 * NEXUS GLASS - iOS/macOS Glass Theme
 * Glassmorphism design with SF Pro font styling
 */

configuration {
    font:               "SF Pro Display Regular 15";
    show-icons:         true;
    icon-theme:         "Papirus";
    display-drun:       "";
    drun-display-format: "{name}";
    disable-history:    false;
    fullscreen:         false;
    hide-scrollbar:     true;
    sidebar-mode:       false;
}

* {
    bg-glass:       rgba(255, 255, 255, 0.10);
    bg-blur:        rgba(28, 22, 54, 0.82);

    fg-primary:     rgba(255, 255, 255, 0.96);
    fg-secondary:   rgba(220, 220, 240, 0.75);
    fg-dim:         rgba(180, 180, 210, 0.50);

    accent:         rgba(122, 162, 247, 0.90);
    selection:      rgba(122, 162, 247, 0.22);

    border-glass:   rgba(255, 255, 255, 0.16);
    transparent:    rgba(0, 0, 0, 0);
}

window {
    background-color:   @bg-blur;
    text-color:         @fg-primary;
    border:             1px;
    border-color:       @border-glass;
    border-radius:      20px;
    width:              720px;
    location:           center;
    padding:            20px;
}

mainbox {
    background-color:   @transparent;
    border:             0px;
    spacing:            16px;
    padding:            0px;
    children:           [ inputbar, listview ];
}

inputbar {
    background-color:   @bg-glass;
    text-color:         @fg-primary;
    border:             1px;
    border-color:       @border-glass;
    border-radius:      12px;
    margin:             0px;
    padding:            12px 16px;
    children:           [ entry ];
}

entry {
    background-color:   @transparent;
    text-color:         @fg-primary;
    placeholder-color:  @fg-dim;
    expand:             true;
    placeholder:        "Search";
    blink:              true;
    border:             0px;
    margin:             0px;
    padding:            4px 0px;
    font:               "SF Pro Display Medium 16";
    horizontal-align:   0;
}

listview {
    background-color:   @transparent;
    text-color:         @fg-primary;
    columns:            1;
    lines:              8;
    spacing:            4px;
    layout:             vertical;
    border:             0px;
    padding:            0px;
    cycle:              true;
    dynamic:            true;
    scrollbar:          false;
}

element {
    background-color:   @transparent;
    text-color:         rgba(175, 165, 220, 0.75);
    border:             0px;
    border-radius:      10px;
    padding:            12px 16px;
    margin:             0px;
    orientation:        horizontal;
}

element selected {
    background-color:   rgba(255,255,255,0.10);
    text-color:         rgba(255,255,255,0.98);
    border:             1px;
    border-color:       rgba(255,255,255,0.16);
    border-radius:      10px;
}

element-icon {
    background-color:   @transparent;
    size:               28px;
    margin:             0px 14px 0px 0px;
    vertical-align:     0.5;
    border-radius:      6px;
}

element-text {
    background-color:   @transparent;
    text-color:         inherit;
    expand:             true;
    horizontal-align:   0;
    vertical-align:     0.5;
    margin:             0px;
    font:               "SF Pro Display Regular 15";
}
