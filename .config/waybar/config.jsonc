/* My Mostly Used waybar config incase you wonder :) */
{
"include": [
  "~/.config/waybar/Modules",
  "~/.config/waybar/ModulesWorkspaces",
  "~/.config/waybar/ModulesCustom",
  "~/.config/waybar/ModulesGroups",
  "~/.config/waybar/UserModules"
],

"layer": "bottom",
"exclusive": true,
"passthrough": false,
"position": "top",
"spacing": 3,
"fixed-center": true,
"ipc": true,

"output": "DP-2",

"margin-top": 3,
"margin-left": 8,
"margin-right": 8,

"modules-left": [
  "clock",
  "custom/separator#blank",
  "tray"
],

"modules-center": [
  "hyprland/workspaces#roman"
],

"modules-right": [
  "group/notify",
  "battery",
  "custom/separator#blank",
  "group/audio",
  "custom/separator#blank",
  "custom/power"
]
}
